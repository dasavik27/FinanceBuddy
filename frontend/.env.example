# FinanceBuddy Frontend Configuration Template
# Copy this file to .env or .env.local for local development.

# Backend API base URL
# In local development, the Vite dev server proxies /api to http://localhost:8000
VITE_API_URL=/api

# Supabase Auth configuration (Required for Google OAuth / Email auth)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
