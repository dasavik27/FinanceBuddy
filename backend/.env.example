# FinanceBuddy Backend Configuration Template
# Copy this file to .env inside the backend/ directory for local development.

# PostgreSQL Connection String (Required in production, SQLite fallback in local dev if unset)
DATABASE_URL=postgresql://postgres:password@localhost:5432/financebuddy

# Encryption key ring for PII data (comma-separated hex or base64 keys, primary is the first)
FINANCEBUDDY_ENCRYPTION_KEYS=primary_32byte_key_here

# Supabase Auth Configuration (for JWT validation and user profile management)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Zerodha Kite Connect SDK Credentials (for broker sync integration)
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret

# Allowed CORS Origins (comma-separated, default is http://localhost:5173 in development)
FINANCEBUDDY_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-app.vercel.app
