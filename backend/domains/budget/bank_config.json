        "description": ["description", "narration", "remarks", "particulars", "memo", "details", "transaction description", "transaction details", "merchant"],
        "amount": ["amount", "txn_amount", "transaction_amount", "net amount", "amt", "value"],
        "type": ["type", "txn_type", "transaction_type", "dr_cr", "cr_dr", "debit/credit"],
        "debit": ["debit", "withdrawal", "withdrawals", "spent", "expense", "dr", "debit amount", "withdrawal amount"],
        "credit": ["credit", "deposit", "deposits", "received", "income", "cr", "credit amount", "deposit amount"],
        "balance": ["balance", "closing balance", "running balance", "available balance"]
      }
