{
  "_comment": [
    "Column aliases per statement format. Matching is on the normalised name",
    "(lowercased, non-alphanumerics stripped), so 'Withdrawal Amt.' and",
    "'withdrawal amt' are the same alias and only one needs listing.",
    "",
    "'balance' is optional but worth providing: it is what lets reconcile.py verify",
    "that opening + sum(transactions) == closing, which catches a mis-parsed column",
    "before it reaches the dashboard.",
    "",
    "Credit-card exports are separate formats, not savings formats with a different",
    "label. They rarely carry a running balance, they often use a single Amount",
    "column with a Cr/Dr marker, and on most issuers a 'debit' is a purchase (money",
    "owed) rather than money leaving an account - see accounts.py for how that",
    "difference is applied downstream."
  ],
  "banks": {
    "hdfc": {
      "columns": {
        "date": ["date", "txn date", "transaction date", "value date"],
        "description": ["narration", "description", "transaction remarks", "particulars"],
        "debit": ["withdrawal amt.", "withdrawal amt", "withdrawal amount", "debit amount", "debit", "dr"],
        "credit": ["deposit amt.", "deposit amt", "deposit amount", "credit amount", "credit", "cr"],
        "balance": ["closing balance", "balance", "running balance", "balance (inr)"]
      }
    },
    "icici": {
      "columns": {
        "date": ["transaction date", "date", "value date", "txn date"],
        "description": ["transaction remarks", "remarks", "narration", "description", "particulars"],
        "debit": ["withdrawal amount(inr)", "withdrawal amount (inr )", "withdrawal amount (inr)", "withdrawal amount", "withdrawal amt.", "withdrawal amt", "debit amount", "debit", "dr amount", "dr"],
        "credit": ["deposit amount(inr)", "deposit amount (inr )", "deposit amount (inr)", "deposit amount", "deposit amt.", "deposit amt", "credit amount", "credit", "cr amount", "cr"],
        "balance": ["balance(inr)", "balance (inr)", "balance", "closing balance", "available balance"]
      }
    },
    "sbi": {
      "columns": {
        "date": ["txn date", "date", "transaction date", "value date"],
        "description": ["description", "narration", "transaction remarks", "particulars", "remarks"],
        "debit": ["debit", "withdrawal amount", "debit amount", "dr"],
        "credit": ["credit", "deposit amount", "credit amount", "cr"],
        "balance": ["balance", "closing balance", "running balance"]
      }
    },
    "axis": {
      "columns": {
        "date": ["tran date", "transaction date", "date", "value date"],
        "description": ["particulars", "description", "narration", "transaction remarks"],
        "debit": ["debit", "withdrawal amount", "dr amount", "dr"],
        "credit": ["credit", "deposit amount", "cr amount", "cr"],
        "balance": ["balance", "closing balance", "running balance"]
      }
    },
    "kotak": {
      "columns": {
        "date": ["transaction date", "date", "value date", "txn date"],
