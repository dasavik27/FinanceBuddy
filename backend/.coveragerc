[run]
source = .
branch = False
omit =
    tests/*
    migrations/*
    */__pycache__/*
    .venv/*
    venv/*
    */site-packages/*
    # One-off / ops scripts are not part of the request path.
    migrate.py
    test_flow.py
    test_pan.py
    seed_*.py
    scripts/*

[report]
precision = 1
show_missing = True
skip_covered = False
# Enforce full line coverage of application code under source=.
fail_under = 100
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    if __name__ == .__main__.:

[html]
directory = htmlcov
